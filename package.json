{
  "name": "vscode-gng-support",
  "displayName": "Groovy & Grails Support",
  "description": "Grails Framework Support for Visual Studio Code",
  "author": "Shivam Kashyap",
  "license": "MIT",
  "version": "0.2.0",
  "publisher": "KingSK1998",
  "repository": {
    "type": "git",
    "url": "https://github.com/KingSK1998/vscode-gng-support.git"
  },
  "bugs": "https://github.com/KingSK1998/vscode-gng-support/issues",
  "homepage": "https://github.com/KingSK1998/vscode-gng-support#readme",
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "Grails",
    "Groovy",
    "Gradle",
    "Grails Framework",
    "Grails Framework Support"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "activationEvents": [
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts",
    "workspaceContains:**/settings.gradle",
    "workspaceContains:**/settings.gradle.kts",
    "workspaceContains:**/gradle.properties",
    "workspaceContains:**/gradlew",
    "workspaceContains:**/gradlew.bat",
    "workspaceContains:**/grails-app",
    "workspaceContains:**/application.yml",
    "workspaceContains:**/application.yaml",
    "workspaceContains:**/application.groovy"
  ],
  "main": "./client/out/extension.js",
  "icon": "./resources/icons/icon.png",
  "extensionDependencies": [
    "vscjava.vscode-gradle"
  ],
  "contributes": {
    "commands": [
      {
        "command": "grails.refreshTree",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Grails"
      },
      {
        "command": "grails.showDashboard",
        "title": "Show Dashboard",
        "icon": "$(dashboard)",
        "category": "Grails"
      },
      {
        "command": "grails.showExtensionInfo",
        "title": "Show Extension Info",
        "icon": "$(info)",
        "category": "Grails"
      },
      {
        "command": "grails.refreshProjects",
        "title": "Refresh Projects",
        "icon": "$(sync)",
        "category": "Grails"
      },
      {
        "command": "grails.showProjectConfig",
        "title": "Show Project Configuration",
        "icon": "$(gear)",
        "category": "Grails"
      },
      {
        "command": "grails.runApp",
        "title": "Run Application",
        "icon": "$(play)",
        "category": "Grails"
      },
      {
        "command": "grails.debugApp",
        "title": "Debug Application",
        "icon": "$(debug-alt)",
        "category": "Grails"
      },
      {
        "command": "grails.showDependencyGraph",
        "title": "Show Dependency Graph",
        "icon": "$(graph)",
        "category": "Grails"
      },
      {
        "command": "grails.showGormSqlPreview",
        "title": "Show GORM SQL Preview",
        "icon": "$(database)",
        "category": "Grails"
      },
      {
        "command": "grails.compileProject",
        "title": "Compile Project",
        "icon": "$(check)",
        "category": "Grails"
      },
      {
        "command": "grails.testApp",
        "title": "Run Tests",
        "icon": "$(beaker)",
        "category": "Grails"
      },
      {
        "command": "grails.buildProject",
        "title": "Build Project",
        "icon": "$(tools)",
        "category": "Grails"
      },
      {
        "command": "grails.cleanProject",
        "title": "Clean Project",
        "icon": "$(trash)",
        "category": "Grails"
      },
      {
        "command": "grails.createController",
        "title": "Create Controller",
        "icon": "$(file-add)",
        "category": "Grails"
      },
      {
        "command": "grails.createService",
        "title": "Create Service",
        "icon": "$(file-add)",
        "category": "Grails"
      },
      {
        "command": "grails.createDomain",
        "title": "Create Domain",
        "icon": "$(file-add)",
        "category": "Grails"
      },
      {
        "command": "grails.createArtifact",
        "title": "Create New Artifact",
        "icon": "$(add)",
        "category": "Grails"
      },
      {
        "command": "grails.restartLanguageServer",
        "title": "Restart Language Server",
        "icon": "$(refresh)",
        "category": "Grails"
      },
      {
        "command": "grails.syncGradle",
        "title": "Sync with Gradle",
        "icon": "$(sync~spin)",
        "category": "Grails"
      },
      {
        "command": "grails.setupWorkspace",
        "title": "Setup Workspace",
        "icon": "$(settings-gear)",
        "category": "Grails"
      },
      {
        "command": "grails.diagnoseIssues",
        "title": "Diagnose Issues",
        "icon": "$(search)",
        "category": "Grails"
      },
      {
        "command": "grails.run",
        "title": "Run Application (Terminal)",
        "category": "Grails"
      },
      {
        "command": "grails.test",
        "title": "Run Tests (Terminal)",
        "category": "Grails"
      },
      {
        "command": "grails.clean",
        "title": "Clean (Terminal)",
        "category": "Grails"
      },
      {
        "command": "grails.compile",
        "title": "Compile (Terminal)",
        "category": "Grails"
      },
      {
        "command": "grails.showConfig",
        "title": "Show Configuration (Legacy)",
        "category": "Grails"
      },
      {
        "command": "grails.openGrailsApp",
        "title": "Open grails-app Folder",
        "category": "Grails"
      },
      {
        "command": "grails.diagnoseGradle",
        "title": "Diagnose Gradle Issues (Legacy)",
        "category": "Grails"
      },
      {
        "command": "grails.runGradleTask",
        "title": "Run Gradle Task (Legacy)",
        "category": "Grails"
      },
      {
        "command": "grails.openDashboard",
        "title": "Open Project Dashboard",
        "category": "Grails"
      },
      {
        "command": "grails.analysis.getCapabilities",
        "title": "Get Project Capabilities",
        "category": "Grails Analysis"
      },
      {
        "command": "grails.analysis.searchSymbols",
        "title": "Search Symbols",
        "category": "Grails Analysis"
      },
      {
        "command": "grails.analysis.explainSymbol",
        "title": "Explain Symbol",
        "category": "Grails Analysis"
      },
      {
        "command": "grails.analysis.getDiagnostics",
        "title": "Get Project Diagnostics",
        "category": "Grails Analysis"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "Grails Forge",
        "properties": {
          "grails.dashboard.autoOpen": {
            "type": "boolean",
            "default": false,
            "description": "Automatically open the Grails dashboard when a project is detected."
          },
          "grails.server.port": {
            "type": "integer",
            "default": 8080,
            "description": "The default port for the Grails application."
          },
          "grails.developer.experimentalFlags": {
            "type": "boolean",
            "default": false,
            "description": "Enable internal maintenance flags and developer tools."
          }
        }
      },
      {
        "title": "Grails",
        "properties": {
          "grails.grailsHome": {
            "type": "string",
            "default": "",
            "description": "Path to Grails installation directory (leave empty to use system PATH)",
            "scope": "machine-overridable"
          },
          "grails.javaHome": {
            "type": "string",
            "default": "",
            "description": "Path to Java installation for Grails (leave empty to use JAVA_HOME or system default)",
            "scope": "machine-overridable"
          },
          "grails.server.autoStart": {
            "type": "boolean",
            "default": false,
            "description": "Automatically start Grails development server when opening a project"
          },
          "grails.languageServer.developmentPort": {
            "type": "number",
            "default": 5007,
            "description": "Port of a manually started language server when development mode is enabled.",
            "minimum": 1024,
            "maximum": 65535
          },
          "grails.completion.detail": {
            "type": "string",
            "enum": [
              "basic",
              "standard",
              "advanced"
            ],
            "enumDescriptions": [
              "Basic completion (faster)",
              "Standard completion with moderate detail",
              "Advanced completion with full details (slower)"
            ],
            "default": "advanced",
            "description": "Level of detail in code completion"
          },
          "grails.completion.maxItems": {
            "type": "number",
            "default": 1000,
            "description": "Maximum completion items to show",
            "minimum": 50,
            "maximum": 2000
          },
          "grails.includeSnippets": {
            "type": "boolean",
            "default": true,
            "description": "Include code snippets in completion suggestions"
          },
          "grails.codeLens.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Show CodeLens annotations (run buttons, references, etc.)"
          },
          "grails.diagnostics.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable error and warning diagnostics"
          },
          "grails.server.jvmArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "-Xmx1g",
              "-XX:+UseG1GC"
            ],
            "description": "JVM arguments for Grails Language Server",
            "scope": "machine-overridable"
          },
          "grails.languageServer.trace": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "Language server communication trace level (for debugging)"
          },
          "grails.cache.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable project information caching for faster startup"
          },
          "grails.cache.directory": {
            "type": "string",
            "default": ".grails-lsp",
            "description": "Cache directory name (relative to project root)"
          },
          "grails.experimental.smartRecompilation": {
            "type": "boolean",
            "default": false,
            "description": "⚠️ EXPERIMENTAL: Smart recompilation on file changes (may be unstable)"
          },
          "grails.debug.logLevel": {
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info",
              "debug"
            ],
            "default": "warn",
            "description": "Extension logging level (restart required)"
          },
          "grails.server.developmentMode": {
            "type": "boolean",
            "default": false,
            "description": "Connect to a manually started language server instead of launching the bundled server. Intended for extension development."
          },
          "grails.icons.suggestMaterialTheme": {
            "type": "boolean",
            "default": true,
            "description": "Show suggestion to install Material Icon Theme for better icons"
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "grails.refreshTree",
          "when": "false"
        },
        {
          "command": "grails.runApp",
          "when": "workspaceContains:**/build.gradle"
        },
        {
          "command": "grails.debugApp",
          "when": "workspaceContains:**/build.gradle"
        },
        {
          "command": "grails.testApp",
          "when": "workspaceContains:**/build.gradle"
        },
        {
          "command": "grails.buildProject",
          "when": "workspaceContains:**/build.gradle"
        },
        {
          "command": "grails.compileProject",
          "when": "workspaceContains:**/build.gradle"
        },
        {
          "command": "grails.cleanProject",
          "when": "workspaceContains:**/build.gradle"
        },
        {
          "command": "grails.createController",
          "when": "workspaceContains:**/grails-app"
        },
        {
          "command": "grails.createService",
          "when": "workspaceContains:**/grails-app"
        },
        {
          "command": "grails.createDomain",
          "when": "workspaceContains:**/grails-app"
        },
        {
          "command": "grails.createArtifact",
          "when": "workspaceContains:**/grails-app"
        },
        {
          "command": "grails.run",
          "when": "workspaceContains:**/grails-app"
        },
        {
          "command": "grails.test",
          "when": "workspaceContains:**/grails-app"
        },
        {
          "command": "grails.clean",
          "when": "workspaceContains:**/grails-app"
        },
        {
          "command": "grails.compile",
          "when": "workspaceContains:**/grails-app"
        }
      ],
      "view/title": [
        {
          "command": "grails.refreshTree",
          "when": "view == grailsExplorer",
          "group": "navigation@1"
        },
        {
          "command": "grails.showDashboard",
          "when": "view == grailsExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "grails.runApp",
          "when": "view == grailsExplorer && viewItem == grailsProject",
          "group": "1_run@1"
        },
        {
          "command": "grails.debugApp",
          "when": "view == grailsExplorer && viewItem == grailsProject",
          "group": "1_run@2"
        },
        {
          "command": "grails.showDependencyGraph",
          "when": "view == grailsExplorer && viewItem == grailsProject",
          "group": "1_run@3"
        },
        {
          "command": "grails.testApp",
          "when": "view == grailsExplorer && viewItem == grailsProject",
          "group": "1_run@2"
        },
        {
          "command": "grails.buildProject",
          "when": "view == grailsExplorer && viewItem == grailsProject",
          "group": "1_run@3"
        },
        {
          "command": "grails.showGormSqlPreview",
          "when": "view == grailsExplorer && viewItem == grailsDomain",
          "group": "1_run@4"
        }
      ],
      "explorer/context": [
        {
          "command": "grails.createController",
          "when": "explorerResourceIsFolder && resourceFilename == controllers",
          "group": "2_workspace@1"
        },
        {
          "command": "grails.createService",
          "when": "explorerResourceIsFolder && resourceFilename == services",
          "group": "2_workspace@1"
        },
        {
          "command": "grails.createDomain",
          "when": "explorerResourceIsFolder && resourceFilename == domain",
          "group": "2_workspace@1"
        },
        {
          "command": "grails.createArtifact",
          "when": "explorerResourceIsFolder && resourcePath =~ /grails-app$/",
          "group": "2_workspace@2"
        }
      ],
      "editor/context": [
        {
          "command": "grails.runApp",
          "when": "resourceLangId == groovy && resourcePath =~ /.*Controller\\.groovy$/",
          "group": "1_run@1"
        }
      ]
    },
    "languages": [
      {
        "id": "groovy",
        "extensions": [
          ".groovy"
        ],
        "configuration": "./resources/language-configurations/groovy-language-configuration.json"
      },
      {
        "id": "gsp",
        "extensions": [
          ".gsp"
        ],
        "aliases": [
          "GSP",
          "Groovy Server Pages"
        ],
        "configuration": "./resources/language-configurations/gsp-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "groovy",
        "scopeName": "source.groovy",
        "path": "./resources/syntaxes/groovy.tmLanguage.json"
      },
      {
        "language": "gsp",
        "scopeName": "source.gsp",
        "path": "./resources/syntaxes/gsp.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "grailsVariable",
        "description": "Injected Grails variables like params, flash, session",
        "superType": "variable"
      },
      {
        "id": "gspTag",
        "description": "Grails TagLib tags",
        "superType": "function"
      },
      {
        "id": "i18nKey",
        "description": "Grails i18n property keys",
        "superType": "property"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "injected",
        "description": "For variables automatically injected by Grails framework"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "grailsVariable": [
            "variable.other.readwrite.instance.groovy",
            "support.variable.grails"
          ],
          "gspTag": [
            "entity.name.tag.grails",
            "support.class.grails"
          ],
          "i18nKey": [
            "constant.other.key.properties",
            "support.type.property-name.grails"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grailsActivityBar",
          "title": "Grails",
          "icon": "resources/icons/grails.svg"
        }
      ]
    },
    "views": {
      "grailsActivityBar": [
        {
          "id": "grailsExplorer",
          "name": "Project Structure",
          "icon": "resources/icons/grails.svg"
        }
      ]
    },
    "snippets": [
      {
        "language": "groovy",
        "path": "./resources/snippets/groovy.json"
      },
      {
        "language": "gsp",
        "path": "./resources/snippets/gsp.json"
      }
    ],
    "languageModelTools": [
      {
        "name": "grails_project_capabilities",
        "displayName": "Grails Project Capabilities",
        "description": "Inspect capabilities and supported operations of a Grails project.",
        "modelDescription": "Inspect Grails project capabilities, framework version, toolchain, and supported operations for a workspace project.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectUri": {
              "type": "string",
              "description": "Canonical URI of the project root"
            },
            "sourceSet": {
              "type": "string",
              "description": "Optional source set scope (main, test)"
            }
          },
          "required": [
            "projectUri"
          ]
        }
      },
      {
        "name": "grails_symbols_search",
        "displayName": "Grails Symbols Search",
        "description": "Search symbols across a Grails project.",
        "modelDescription": "Search declarations and symbols in a Grails project with origin kinds and provenance.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectUri": {
              "type": "string",
              "description": "Canonical URI of the project root"
            },
            "query": {
              "type": "string",
              "description": "Query string or regex pattern"
            },
            "uri": {
              "type": "string",
              "description": "Optional document URI to scope the search"
            },
            "sourceSet": {
              "type": "string",
              "description": "Optional source set scope"
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional symbol kinds filter"
            },
            "limit": {
              "type": "number",
              "description": "Maximum number of items to return"
            },
            "maxPayloadBytes": {
              "type": "number",
              "description": "Maximum payload size in bytes"
            },
            "cursor": {
              "type": "string",
              "description": "Opaque pagination cursor"
            }
          },
          "required": [
            "projectUri",
            "query"
          ]
        }
      },
      {
        "name": "grails_symbols_explain",
        "displayName": "Grails Symbol Explain",
        "description": "Explain a symbol at a specific location or identifier in a Grails project.",
        "modelDescription": "Explain a symbol, its provenance, resolution kind, and signature in a Grails project.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectUri": {
              "type": "string",
              "description": "Canonical URI of the project root"
            },
            "documentUri": {
              "type": "string",
              "description": "Document URI containing the symbol"
            },
            "symbolName": {
              "type": "string",
              "description": "Name of the symbol to explain"
            },
            "line": {
              "type": "number",
              "description": "0-based line number"
            },
            "character": {
              "type": "number",
              "description": "0-based character offset"
            }
          },
          "required": [
            "projectUri",
            "documentUri"
          ]
        }
      },
      {
        "name": "grails_project_diagnostics",
        "displayName": "Grails Project Diagnostics",
        "description": "Get current diagnostics for a Grails project or document.",
        "modelDescription": "Retrieve compile and analysis diagnostics with provenance and severity for a Grails project or document.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectUri": {
              "type": "string",
              "description": "Canonical URI of the project root"
            },
            "documentUri": {
              "type": "string",
              "description": "Optional document URI filter"
            },
            "severity": {
              "type": "string",
              "enum": [
                "Error",
                "Warning",
                "Information",
                "Hint"
              ],
              "description": "Optional minimum severity level"
            },
            "limit": {
              "type": "number",
              "description": "Maximum count of diagnostics to return"
            }
          },
          "required": [
            "projectUri"
          ]
        }
      }
    ]
  },
  "configurationDefaults": {
    "editor.semanticTokenColorCustomizations": {
      "rules": {
        "grailsVariable": "#C586C0",
        "i18nKey": "#C586C0",
        "gspTag": "#4EC9B0"
      }
    }
  },
  "scripts": {
    "setup": "npm install && node scripts/install-hooks.js",
    "guard": "node scripts/pre-commit-guard.js",
    "copy-server": "node scripts/copy-server.js",
    "build": "npm run build:server && npm run copy-server && npm run build:client",
    "build:client": "npm run compile && npm run bundle",
    "build:server": "node scripts/gradle.js shadowJar",
    "compile": "tsc -p ./tsconfig.json",
    "bundle": "node scripts/bundle.js",
    "watch": "npm-run-all --parallel watch:*",
    "watch:compile": "npm run compile -- --watch",
    "watch:bundle": "npm run bundle -- --watch",
    "check-types": "tsc -p ./tsconfig.json --noEmit",
    "lint": "eslint client/src/**/*.ts --ext ts",
    "lint:fix": "eslint client/src/**/*.ts --ext ts --fix",
    "format": "prettier --write client/src/**/*.{ts,json}",
    "check": "npm run lint && npm run format && npm run check-types",
    "clean": "node scripts/clean.js",
    "test": "npm run test:client && npm run test:server",
    "test:client": "npm run compile && node scripts/test-client.js",
    "test:server": "node scripts/gradle.js test",
    "test:smoke": "node scripts/smoke-server.js",
    "benchmark:perf": "node scripts/run-benchmarks.js",
    "package": "vsce package --out vscode-gng-support.vsix",
    "vscode:prepublish": "npm run build",
    "graphify": "graphify .",
    "graphify:update": "graphify . --update",
    "graphify:watch": "graphify . --watch",
    "graphify:open": "start graphify-out/graph.html"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.3.0",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "chai": "^6.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.33.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^11.7.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
